{
  "manifest_version": 3,
  "name": "Kimi visible thinking translator (experimental)",
  "version": "0.1.0",
  "description": "Translate only expanded, visible thinking in Kimi Code Web and kimi.com. Requires language confirmation.",
  "permissions": ["storage"],
  "host_permissions": ["https://edge.microsoft.com/*"],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "content_scripts": [{
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://kimi.com/*",
      "https://www.kimi.com/*"
    ],
    "js": ["core.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
