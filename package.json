{
  "name": "kimi-cot-translate",
  "version": "0.2.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node --test test.cjs runtime-hook.test.mjs cli.test.mjs cli-acp.test.mjs",
    "test:macos": "node --test runtime.test.mjs",
    "test:windows": "node --test runtime-windows.test.mjs",
    "test:browser": "node --test --test-timeout=30000 browser/browser.test.mjs",
    "build:browser": "node browser/build.mjs",
    "test:vscode": "node --test vscode/test.cjs",
    "build:vscode": "node vscode/build.cjs",
    "version:sync": "node scripts/version-sync.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "description": "Visible thinking translation for Kimi Code desktop, an ACP terminal, and browser previews.",
  "repository": {
    "type": "git",
    "url": "https://github.com/wssz527/kimi-cot-translate.git"
  },
  "homepage": "https://github.com/wssz527/kimi-cot-translate#readme",
  "private": true,
  "license": "MIT",
  "author": "wssz527",
  "bugs": {
    "url": "https://github.com/wssz527/kimi-cot-translate/issues"
  },
  "keywords": [
    "kimi-code",
    "thinking",
    "chain-of-thought",
    "translation",
    "i18n",
    "electron",
    "browser-extension"
  ]
}
